{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Measure Update Request",
  "description": "A measure composed of an integer value and a unit descriptor. Its value is the integer count of `10^-scale` units of `unit`.",
  "type": "object",
  "properties": {
    "value": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Integer count of `10^-scale` units of `unit`."
    }
  },
  "required": [
    "value"
  ],
  "allOf": [
    {
      "$ref": "unit_update_request.json"
    }
  ]
}